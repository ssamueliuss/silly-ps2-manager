{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "silly-ps2-manager",
  "version": "0.1.0",
  "identifier": "com.sillydevs.ps2manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Silly PS2 Manager | by Samuel Antunez (sillydevs.vercel.app)",
        "width": 1090,
        "height": 690,
        "minWidth": 1090,
        "minHeight": 690,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
